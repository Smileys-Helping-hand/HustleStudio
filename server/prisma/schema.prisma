// Prisma schema for Hustle Studio backend
// datasource and generator configuration should be defined elsewhere.

model FaultCode {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  description String
  subsystem   String
  causes      String
  checks      String
  repairs     String
  diagramUrl  String?
  createdAt   DateTime @default(now())
}
