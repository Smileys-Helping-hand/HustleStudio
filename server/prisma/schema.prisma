// Prisma schema for Hustle Studio backend

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model FaultCode {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  description String
  subsystem   String
  causes      String
  checks      String
  repairs     String
  diagramUrl  String?
  createdAt   DateTime @default(now())
}
