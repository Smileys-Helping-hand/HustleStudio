rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is a member of the tenant
    function isTenantMember(tenantId) {
      return request.auth != null && 
             exists(/databases/$(database)/documents/tenants/$(tenantId)/users/$(request.auth.uid));
    }
    
    // Helper function to check if user has a specific role in the tenant
    function hasRole(tenantId, role) {
      return request.auth != null && 
             get(/databases/$(database)/documents/tenants/$(tenantId)/users/$(request.auth.uid)).data.role == role;
    }
    
    // Tenant documents - authenticated users can read their own tenants
    match /tenants/{tenantId} {
      allow read: if request.auth != null && isTenantMember(tenantId);
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null && isTenantMember(tenantId) && 
                       (hasRole(tenantId, 'Owner') || hasRole(tenantId, 'Admin'));
      allow delete: if request.auth != null && hasRole(tenantId, 'Owner');
      
      // Subcollections under tenants
      match /{document=**} {
        allow read: if request.auth != null && isTenantMember(tenantId);
        allow write: if request.auth != null && isTenantMember(tenantId);
      }
    }

    // Admin collection
    match /admin/{document=**} {
      allow read, write: if request.auth != null && request.auth.token.role == 'Owner';
    }

    // Telemetry collection
    match /telemetry/{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
